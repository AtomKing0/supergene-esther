<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- LaunchAgent 식별자 -->
    <key>Label</key>
    <string>com.supergene.balance-diff</string>

    <!-- 실행할 명령 -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>SCRIPT_PATH_PLACEHOLDER</string>
    </array>

    <!-- 매일 오전 9시 실행 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- stdout / stderr 로그 -->
    <key>StandardOutPath</key>
    <string>LOG_PATH_PLACEHOLDER</string>

    <key>StandardErrorPath</key>
    <string>ERR_PATH_PLACEHOLDER</string>

    <!-- 실패 시 재시도 안 함 (매일 1회) -->
    <key>ThrottleInterval</key>
    <integer>3600</integer>

    <!-- 로그인 세션에서만 실행 -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
